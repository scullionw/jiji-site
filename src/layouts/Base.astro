---
import "../styles/tokens.css";
import "../styles/global.css";
import { themes, DARK_DEFAULT, LIGHT_DEFAULT, STORAGE_KEY } from "../themes";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Jiji: a desktop workbench for Jujutsu",
  description = "Jiji is a macOS workbench for Jujutsu (jj): the change graph, the diff of whatever you select, an undoable operation log, and stacked-PR publishing, built on jj-lib.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
const boot = {
  schemes: Object.fromEntries(themes.map((t) => [t.id, t.scheme])),
  dark: DARK_DEFAULT,
  light: LIGHT_DEFAULT,
  key: STORAGE_KEY,
};
---

<!doctype html>
<html lang="en" data-theme={DARK_DEFAULT} data-scheme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Jiji showing a jj repository's change graph and a diff" />
    <meta property="og:site_name" content="Jiji" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Pick the palette before first paint: a theme chosen on this page,
         otherwise Midnight or Paper following the system appearance. -->
    <script is:inline define:vars={{ boot }}>
      (function () {
        var root = document.documentElement;
        var id = null;
        try {
          id = localStorage.getItem(boot.key);
        } catch (e) {}
        if (!id || !boot.schemes[id]) {
          id = matchMedia("(prefers-color-scheme: light)").matches ? boot.light : boot.dark;
        }
        root.dataset.theme = id;
        root.dataset.scheme = boot.schemes[id];
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
