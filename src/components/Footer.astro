---
import Logo from "./Logo.astro";
import {
  CHANGELOG_URL,
  DOWNLOAD_URL,
  GITHUB_URL,
  JJ_URL,
  LICENSE_URL,
  RELEASES_URL,
  SUPPORT_EMAIL,
  VERSION,
} from "../config";
---

<footer class="footer">
  <div class="container cta">
    <div>
      <h2>Try it on your repository</h2>
      <p class="meta">
        v{VERSION}<span class="sep">·</span>macOS<span class="sep">·</span>
        <a href={RELEASES_URL}>release notes</a>
      </p>
    </div>
    <a class="btn primary" href={DOWNLOAD_URL}>Download for macOS</a>
  </div>

  <div class="container base">
    <Logo href={null} size={18} />
    <nav aria-label="Footer">
      <a href={GITHUB_URL}>GitHub</a>
      <a href={CHANGELOG_URL}>Changelog</a>
      <a href={LICENSE_URL}>License</a>
      <a href={`mailto:${SUPPORT_EMAIL}`}>Contact</a>
      <a href={JJ_URL}>What is jj?</a>
    </nav>
    <span class="meta">© 2026 Jiji</span>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--clr-border-2);
    background: var(--clr-bg-0);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-5);
    padding-block: clamp(40px, 6vw, 64px);
  }

  h2 {
    font-size: var(--fs-h2);
  }

  .cta .meta {
    margin-top: var(--sp-2);
  }

  .cta .meta a:hover,
  nav a:hover {
    color: var(--clr-text-1);
  }

  .base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3) var(--sp-6);
    padding-block: var(--sp-5);
    border-top: 1px solid var(--clr-border-2);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-5);
    font-size: var(--fs-small);
    color: var(--clr-text-2);
  }

  .base .meta {
    margin-left: auto;
  }
</style>
