---
import { PRICING } from "../config";
import { themes } from "../themes";

const tiers = [
  {
    name: "Free",
    price: "$0",
    note: "Everything jj in Jiji",
    lines: ["Every feature, no time limit", "The default light theme", "Updates included"],
    cta: null,
  },
  {
    name: PRICING.solo.name,
    price: PRICING.solo.price,
    note: "One-time purchase",
    lines: [PRICING.solo.devices, "All ten themes, light and dark", "Funds development"],
    cta: { href: PRICING.solo.url, label: `Buy ${PRICING.solo.name}` },
  },
  {
    name: PRICING.personal.name,
    price: PRICING.personal.price,
    note: "One-time purchase",
    lines: [PRICING.personal.devices, "All ten themes, light and dark", "Funds development"],
    cta: { href: PRICING.personal.url, label: `Buy ${PRICING.personal.name}` },
  },
];
---

<section class="band" id="pricing">
  <div class="container">
    <div class="band-head">
      <h2>Free to use. Themes if you'd like to support it.</h2>
      <p>
        Every jj feature works without a license. A one-time license unlocks the color themes
        and pays for development; without one, Jiji uses its default light theme.
      </p>
    </div>

    <div class="tiers">
      {
        tiers.map((t) => (
          <article class="tier">
            <h3>{t.name}</h3>
            <p class="price">
              {t.price}
              <span>{t.note}</span>
            </p>
            <ul>
              {t.lines.map((line) => (
                <li>{line}</li>
              ))}
            </ul>
            {t.cta ? (
              <a class="btn secondary buy" href={t.cta.href}>
                {t.cta.label}
              </a>
            ) : (
              <span class="included">Included with the download</span>
            )}
          </article>
        ))
      }
    </div>

    <div class="themes">
      <p>Try the themes on this page:</p>
      <div class="swatches" role="radiogroup" aria-label="Theme">
        {
          themes.map((t) => (
            <button
              type="button"
              role="radio"
              aria-checked="false"
              data-theme-id={t.id}
              data-scheme={t.scheme}
              title={t.label}
              style={`--sw-bg: ${t.bg}; --sw-accent: ${t.accent}`}
            >
              <span class="sw" aria-hidden="true" />
              {t.label}
            </button>
          ))
        }
      </div>
    </div>

    <p class="meta fine">
      Checkout and license keys are handled by Polar, taxes included. The key arrives by email;
      paste it into Jiji to unlock the themes.
    </p>
  </div>
</section>

<script>
  import { STORAGE_KEY } from "../themes";

  const root = document.documentElement;
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-theme-id]");
  const mark = () => {
    for (const b of buttons) {
      b.setAttribute("aria-checked", String(b.dataset.themeId === root.dataset.theme));
    }
  };
  for (const b of buttons) {
    b.addEventListener("click", () => {
      root.dataset.theme = b.dataset.themeId;
      root.dataset.scheme = b.dataset.scheme;
      try {
        localStorage.setItem(STORAGE_KEY, b.dataset.themeId ?? "");
      } catch {
        // Private windows can refuse storage; the pick still applies here.
      }
      mark();
    });
  }
  mark();
</script>

<style>
  .tiers {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid var(--clr-border-2);
    border-radius: var(--radius-l);
    overflow: hidden;
  }

  .tier {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    padding: var(--sp-6);
    background: var(--clr-bg-1);
  }

  .tier + .tier {
    border-left: 1px solid var(--clr-border-2);
  }

  h3 {
    font-size: 1rem;
  }

  .price {
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }

  .price span {
    display: block;
    font-size: var(--fs-small);
    font-weight: 400;
    letter-spacing: 0;
    color: var(--clr-text-3);
  }

  ul {
    list-style: none;
    display: grid;
    gap: var(--sp-1);
    font-size: 0.9375rem;
    color: var(--clr-text-2);
  }

  .buy,
  .included {
    margin-top: auto;
  }

  .included {
    display: flex;
    align-items: center;
    height: 40px;
    font-size: var(--fs-small);
    color: var(--clr-text-3);
  }

  .themes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3) var(--sp-4);
    margin-top: var(--sp-6);
    font-size: var(--fs-small);
    color: var(--clr-text-2);
  }

  .swatches {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }

  .swatches button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 28px;
    padding: 0 10px 0 6px;
    border-radius: var(--radius-m);
    border: 1px solid var(--clr-border-2);
    background: var(--clr-bg-2);
    font: inherit;
    font-size: 0.8125rem;
    color: var(--clr-text-2);
    cursor: pointer;
  }

  .swatches button:hover {
    color: var(--clr-text-1);
  }

  .swatches button[aria-checked="true"] {
    border-color: var(--clr-accent);
    color: var(--clr-text-1);
  }

  /* The theme's pane color with its accent as a dot, like the app's picker. */
  .sw {
    display: grid;
    place-items: center;
    width: 16px;
    height: 16px;
    border-radius: var(--radius-s);
    background: var(--sw-bg);
    box-shadow: inset 0 0 0 1px rgb(128 128 128 / 0.35);
  }

  .sw::after {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sw-accent);
  }

  .fine {
    margin-top: var(--sp-5);
  }

  @media (max-width: 760px) {
    .tiers {
      grid-template-columns: 1fr;
    }

    .tier + .tier {
      border-left: 0;
      border-top: 1px solid var(--clr-border-2);
    }
  }
</style>
