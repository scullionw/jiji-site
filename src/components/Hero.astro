---
import { DOWNLOAD_URL, GITHUB_URL, RELEASES_URL, VERSION } from "../config";
---

<section class="hero">
  <div class="container">
    <div class="intro">
      <h1>A desktop workbench for&nbsp;Jujutsu</h1>
      <p class="lead">
        Jiji puts <a class="link" href="https://github.com/jj-vcs/jj">jj</a>'s model on
        screen: your stacks on trunk, the diff of whatever you select, and an operation log
        that makes every rewrite undoable. It is built on jj-lib, so it works with the repo
        and config you already have, alongside the CLI.
      </p>
      <div class="actions">
        <a class="btn primary" href={DOWNLOAD_URL}>
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2.5v8M4.5 7 8 10.5 11.5 7M3 13.5h10"></path></svg>
          Download for macOS
        </a>
        <a class="btn secondary" href={GITHUB_URL}>Source on GitHub</a>
      </div>
      <p class="meta">
        <a href={RELEASES_URL}>v{VERSION}</a><span class="sep">·</span>Apple Silicon and
        Intel<span class="sep">·</span>signed and notarized<span class="sep">·</span>free to use
      </p>
    </div>

    <figure class="shot">
      <img
        class="dark"
        src="/screens/workbench-dark.png"
        width="2280"
        height="1422"
        loading="lazy"
        decoding="async"
        alt="Jiji on the jj repository: five workstreams in the change graph, and the diff of a change that adds an op log filter"
      />
      <img
        class="light"
        src="/screens/workbench-light.png"
        width="2280"
        height="1422"
        loading="lazy"
        decoding="async"
        alt="Jiji on the jj repository: five workstreams in the change graph, and the diff of a change that adds an op log filter"
      />
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(40px, 7vw, 80px);
    padding-bottom: var(--band);
  }

  .intro {
    max-width: 720px;
  }

  h1 {
    font-size: var(--fs-hero);
  }

  .lead {
    margin-top: var(--sp-4);
    font-size: var(--fs-lead);
    color: var(--clr-text-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin-top: var(--sp-6);
  }

  .meta {
    margin-top: var(--sp-4);
  }

  .meta a:hover {
    color: var(--clr-text-1);
  }

  .shot {
    margin-top: clamp(36px, 5vw, 56px);
    border-radius: var(--radius-xl);
    border: 1px solid var(--clr-border-1);
    box-shadow: var(--shadow-popover);
    overflow: hidden;
    background: var(--clr-bg-0);
    aspect-ratio: 2280 / 1422;
  }

  .shot img {
    width: 100%;
  }

  :global([data-scheme="dark"]) .shot .light,
  :global([data-scheme="light"]) .shot .dark {
    display: none;
  }
</style>
