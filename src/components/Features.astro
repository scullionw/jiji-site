---
// What the app does, each with the jj command it stands in for. Keep every
// claim true of the current release.
const features = [
  {
    title: "Read history",
    body: "A dense graph of your stacks on trunk, with how far each sits behind it. Switch the lens to your own work, your team's bookmarks, recent changes, or any revset.",
    jj: "jj log -r <revset>",
  },
  {
    title: "Review diffs",
    body: "Unified or split, syntax-highlighted, with a file tree. Read a whole stack as one diff, scrub through a change's evolution, and annotate any file.",
    jj: "jj diff · jj evolog · jj file annotate",
  },
  {
    title: "Rewrite directly",
    body: "Describe, new, edit, squash, split down to single lines, absorb, abandon and revert. Drag a change onto a new parent to rebase it.",
    jj: "jj squash -i · jj split · jj rebase",
  },
  {
    title: "Undo anything",
    body: "Every action is one jj operation. Undo it from the status bar, back out a single operation, or restore the repository to any point in its history.",
    jj: "jj undo · jj op revert · jj op restore",
  },
  {
    title: "Resolve conflicts",
    body: "A conflicted file renders as its merge structure, each side against the base, instead of marker soup. Take a side, or open your merge tool.",
    jj: "jj resolve",
  },
  {
    title: "Manage bookmarks",
    body: "Create, move, rename, track and delete bookmarks. Remotes are fetched in the background, and nothing is pushed until you ask.",
    jj: "jj bookmark · jj git fetch · jj git push",
  },
];
---

<section class="band" id="features">
  <div class="container">
    <div class="band-head">
      <h2>jj, on one screen</h2>
      <p>
        The graph and the diff stay side by side, and the rest of jj is a click or a
        keystroke away. A command palette (⌘K) reaches everything else.
      </p>
    </div>
    <ul class="grid">
      {
        features.map((f) => (
          <li>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
            <code class="jj">{f.jj}</code>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0 clamp(20px, 3vw, 40px);
  }

  li {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    padding: var(--sp-5) 0 var(--sp-8);
    border-top: 1px solid var(--clr-border-2);
  }

  h3 {
    font-size: 1rem;
  }

  p {
    font-size: 0.9375rem;
    color: var(--clr-text-2);
  }

  /* Plain muted text, not the inline-code chip: these wrap freely. */
  .jj {
    margin-top: auto;
    padding: var(--sp-1) 0 0;
    background: none;
    white-space: normal;
    font-size: var(--fs-code);
    color: var(--clr-text-3);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 580px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
